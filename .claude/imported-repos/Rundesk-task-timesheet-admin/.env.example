# Required. Use a dedicated development database; never commit real credentials.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/rundesk"

# Optional development identity. Defaults to the seeded development user.
DEV_USER_EMAIL="munazza@aura.local"

# Automations engine storage. "memory" (default) keeps workflows in-process with
# mock tasks and needs no database; "prisma" persists workflows and run logs in
# the MySQL database above.
AUTOMATION_REPO=memory
