# ── Teams-Pulse environment ─────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your MySQL credentials.
#
# If these are left blank, the app automatically falls back to the built-in
# seed data (lib/mock.js) so you can preview the UI with ZERO setup.
# Fill them in to run against a real MySQL database.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=teams_pulse

# Set to "1" to force the in-memory mock data even if MySQL vars are set.
USE_MOCK_DB=0
