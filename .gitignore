node_modules
.pnpm-store
.idea
.vscode
dist
# A second build of either app beside its `dist` — `dist-brk` was one, a
# break run's bundle, and 1,838 of its files were committed before this line.
dist-*
build
.next
.turbo
.vercel

# Env
*.env
*.env.local
!.env.example

# Logs & OS cruft
*.log
.DS_Store

# Test & coverage
coverage
.nyc_output

# TS build artifacts that should NEVER live next to sources
# (our packages use "main": "./src/index.ts" — any emitted files are stale)
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map

# TS incremental cache
*.tsbuildinfo

# Written by deploy/lib/publish-web-dist.sh on the deploy host: the list of
# chunks a build emitted, read by the next deploy to know which files on disk
# belong to the outgoing release and are worth keeping.
apps/web/.build-assets

# Vite writes this beside the config while a build resolves it and removes it
# afterwards. With several builds running at once, an unlucky `git add -A`
# commits one; it is machine-specific and meaningless to anybody else.
vite.config.ts.timestamp-*.mjs
*.timestamp-*.mjs
# stale-chunk-recovery builds its two releases in a throwaway copy of apps/web
apps/.web-release-*/

# What a gate writes beside its subject while it runs and removes afterwards:
# a mutant (`scripts/lib/mutate.mjs`) and the stub gates' probes. A gate ended
# before it could remove them left eleven probes that `git add -A` staged
# (found-29-sep/killed-mutants-outlive-their-run).
.*-mutant-*
apps/api/.s3-stub-probe-*.ts
apps/api/.model-stub-probe-*.ts
