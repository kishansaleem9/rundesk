# ---------------------------------------------------------------------------
# Rundesk env template.
# Copy this to `.env` (repo root) and fill in real values.
# Apps load env from ./env (app-local) and ../../.env (monorepo root).
# ---------------------------------------------------------------------------

# Database — the port matches the docker-compose.yml mapping (host 5433 -> container 5432)
DATABASE_URL=postgresql://rundesk:rundesk%40aura@localhost:5433/rundesk
REDIS_URL=redis://localhost:6379

# Auth — rotate for production, minimum 32 chars each
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (leave empty to disable — SSO strategies are skipped until these are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_AUTH_URL=https://gitlab.com/oauth/authorize
GITLAB_TOKEN_URL=https://gitlab.com/oauth/token
GITLAB_API_URL=https://gitlab.com/api/v4
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
MICROSOFT_GRAPH_API_URL=https://graph.microsoft.com/v1.0
OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/callback
INTEGRATIONS_OAUTH_STATE_SECRET=

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# AI (Anthropic is used for AI features; leave empty to disable ai.* flags)
ANTHROPIC_API_KEY=

# File storage — Cloudflare R2 (S3-compatible)
# Endpoint is derived as https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rundesk-files
# Optional: public CDN URL for served uploads (e.g. https://files.yourdomain.com)
R2_PUBLIC_URL=

# Search — Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=rundesk_meili_dev_key

# Email — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@rundesk.internal
# Legacy fallback (used when SMTP_FROM is not set)
EMAIL_FROM=noreply@rundesk.internal

# Web Push (closed-browser notifications)
# Generate VAPID keys and set these in server env.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@rundesk.internal
