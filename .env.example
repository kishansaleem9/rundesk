# ---------------------------------------------------------------------------
# Rundesk env template.
# Copy this to `.env` (repo root) and fill in real values.
# Apps load env from ./env (app-local) and ../../.env (monorepo root).
# ---------------------------------------------------------------------------

# Database — the port matches the docker-compose.yml mapping (host 5433 -> container 5432)
DATABASE_URL=postgresql://rundesk:rundesk%40aura@localhost:5433/rundesk
REDIS_URL=redis://localhost:6379

# Auth — rotate for production, minimum 32 chars each
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (leave empty to disable — SSO strategies are skipped until these are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_AUTH_URL=https://gitlab.com/oauth/authorize
GITLAB_TOKEN_URL=https://gitlab.com/oauth/token
GITLAB_API_URL=https://gitlab.com/api/v4
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
MICROSOFT_GRAPH_API_URL=https://graph.microsoft.com/v1.0
OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/callback
INTEGRATIONS_OAUTH_STATE_SECRET=

# Social login (Google/Microsoft "Sign in with…" — Plan §1.1).
# Distinct from the integration OAuth creds above. Leave empty to disable a
# provider: its button is hidden and GET /auth/oauth/providers reports it false.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Base the provider redirect_uri is built from: `${OAUTH_REDIRECT_BASE}/auth/oauth/:provider/callback`.
# Defaults to `${API_URL}/api/v1` (the global route prefix) when unset.
OAUTH_REDIRECT_BASE=
# Optional HMAC key for the signed OAuth state cookie; falls back to JWT_ACCESS_SECRET.
OAUTH_STATE_SECRET=

# App
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
PORT=3001
# Web dev only — Vite proxies /api here; socket.io uses the same origin on port 5173.
VITE_DEV_API_ORIGIN=http://localhost:3001
NODE_ENV=development

# AI (Anthropic is used for AI features; leave empty to disable ai.* flags)
ANTHROPIC_API_KEY=

# File storage — Cloudflare R2 (S3-compatible)
# Endpoint is derived as https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rundesk-files
# Optional: public CDN URL for served uploads (e.g. https://files.yourdomain.com)
R2_PUBLIC_URL=

# Search — Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=rundesk_meili_dev_key

# Email — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@rundesk.internal
# Legacy fallback (used when SMTP_FROM is not set)
EMAIL_FROM=noreply@rundesk.internal

# A mailbox linked over IMAP (found-12-oct/task-email-imap-unbuilt).
# TOKEN_ENCRYPTION_KEY seals each mailbox's password (AES-256-GCM): 32 bytes, as 64 hex
# digits or base64 — e.g. `openssl rand -hex 32`. Unset, no mailbox is linked over IMAP.
# Changing it leaves every sealed password unreadable: those mailboxes ask to be linked again.
TOKEN_ENCRYPTION_KEY=
# Private mail servers the API may reach (it refuses private addresses otherwise), as host:port.
MAILBOX_PRIVATE_SERVERS=
# A PEM file of extra certificate authorities to trust for those servers' TLS.
MAILBOX_TLS_CA_FILE=

# Web Push (closed-browser notifications)
# Generate VAPID keys and set these in server env.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@rundesk.internal

# Importers that sign in to the tool (found-13-oct/importers-by-sign-in-unbuilt): each app's
# OAuth client, registered with the tool, its redirect URI
# <API_PUBLIC_URL>/api/v1/import/apps/<asana|jira|todoist|wrike>/callback. Trello takes an
# API key whose allowed origin is APP_URL; Monday needs nothing here (its token is pasted).
# Unset, a tool's tab says which of these it lacks.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
TRELLO_API_KEY=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
WRIKE_CLIENT_ID=
WRIKE_CLIENT_SECRET=
