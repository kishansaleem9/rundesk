# Rundesk production .env — copy to repo root as .env on the server.
# Do NOT commit this filled-in file. Rotate JWT secrets if leaked.

# Database (rewritten by docker-compose to use the postgres service hostname)
POSTGRES_USER=rundesk
POSTGRES_PASSWORD=rundesk@aura
POSTGRES_DB=rundesk
DATABASE_URL=postgresql://rundesk:rundesk%40aura@postgres:5432/rundesk
REDIS_URL=redis://redis:6379

# Auth — these are pre-generated; rotate if you'd like.
JWT_ACCESS_SECRET=5a84f795d1312c9b2b81b169c44d312c5701e9f68969dedadafe685ea0d4816c
JWT_REFRESH_SECRET=8f089541bf3a798ca0f8e0951a831eb8ebee05cfeb895538586f9fa93cd6c4d2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth — leave empty until SSO apps are configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_AUTH_URL=https://gitlab.com/oauth/authorize
GITLAB_TOKEN_URL=https://gitlab.com/oauth/token
GITLAB_API_URL=https://gitlab.com/api/v4
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
MICROSOFT_GRAPH_API_URL=https://graph.microsoft.com/v1.0
OAUTH_CALLBACK_URL=https://rundesk.theaura.agency/api/v1/auth/callback
INTEGRATIONS_OAUTH_STATE_SECRET=

# App
APP_URL=https://rundesk.theaura.agency
API_URL=https://rundesk.theaura.agency
API_PUBLIC_URL=https://rundesk.theaura.agency
PORT=3001
NODE_ENV=production
# How many proxies stand in front of the API, each appending to X-Forwarded-For.
# Behind the host's nginx that is one: the client's address is the entry nginx
# appends, and the entries before it (which the client writes) are never read.
# Every per-address limit and the workspace IP allowlist read that address.
# Unset or false means none: the socket's address, which behind nginx is the
# same for every visitor. `true` is read as 1. Anything else stops the API.
TRUST_PROXY=1

# AI — optional
ANTHROPIC_API_KEY=

# File storage — Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rundesk-files
# Avatars and workspace logos only, in a bucket of their own, with a domain on
# THAT bucket alone; both or neither. Never connect a domain to R2_BUCKET_NAME:
# it serves every key in it (see .env.example).
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_URL=

# Search — Meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=2c866c09a5e1fcc8065922ca77095b2fa7b2d92dce29e822

# Email — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@rundesk.theaura.agency
EMAIL_FROM=noreply@rundesk.theaura.agency

# A mailbox linked over IMAP (found-12-oct/task-email-imap-unbuilt).
# TOKEN_ENCRYPTION_KEY seals each mailbox's password (AES-256-GCM): 32 bytes, as 64 hex
# digits or base64 — e.g. `openssl rand -hex 32`. Unset, no mailbox is linked over IMAP.
# Changing it leaves every sealed password unreadable: those mailboxes ask to be linked again.
TOKEN_ENCRYPTION_KEY=
# Private mail servers the API may reach (it refuses private addresses otherwise), as host:port.
MAILBOX_PRIVATE_SERVERS=
# A PEM file of extra certificate authorities to trust for those servers' TLS.
MAILBOX_TLS_CA_FILE=

# Web Push (closed-browser notifications)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@rundesk.theaura.agency
