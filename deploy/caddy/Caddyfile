{
  email admin@theaura.agency
}

rundesk.theaura.agency {
  encode zstd gzip

  # WebSocket / Socket.io for realtime
  @realtime path /realtime /realtime/*
  reverse_proxy @realtime api:3001

  # API + Swagger
  @api path /api/* /api
  reverse_proxy @api api:3001

  # Static SPA — fallback to index.html for client-side routing
  root * /srv
  try_files {path} /index.html
  file_server

  log {
    output file /var/log/caddy/access.log
    format json
  }
}
